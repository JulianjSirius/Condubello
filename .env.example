POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=condubello
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-clave

# Clave JWT (mínimo 32 caracteres). Genera una con: openssl rand -base64 48
JWT_KEY=
# Administrador inicial (se crea si no existe ninguno)
SEED_ADMIN_EMAIL=admin@condubello.com
SEED_ADMIN_PASSWORD=Admin123*

# Puertos expuestos en el host
WEB_PORT=8080
GATEWAY_PORT=5000

# Geocodificación (clave de https://cloud.maptiler.com; opcional)
MAPTILER_API_KEY=

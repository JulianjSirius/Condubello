{
  "Jwt": {
    "Key": "",
    "Issuer": "Condubello.Api",
    "Audience": "Condubello.Clientes"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "api",
        "Order": 1,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/auth/login", "Methods": [ "POST" ] }
      },
      "auth-registro": {
        "ClusterId": "api",
        "Order": 1,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/auth/registro", "Methods": [ "POST" ] }
      },
      "api": {
        "ClusterId": "api",
        "Order": 10,
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "principal": { "Address": "http://localhost:5086/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
